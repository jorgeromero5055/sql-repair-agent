# Copy to .env and fill in. Nothing here is secret.

# The app's database. Docker Compose puts Postgres on 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sqlrepair

# The agent's login. Read-only, sandbox schema only — created by a migration.
AGENT_DATABASE_URL=postgresql://agent_ro:choose-a-password@localhost:5433/sqlrepair

# Used once, by the migration that creates the agent_ro role. Must match the password above.
AGENT_DB_PASSWORD=choose-a-password

# Only used when deployed. Any value locally.
QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/placeholder
AWS_DEFAULT_REGION=us-east-1

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local only. Runs the worker in the API process after the response is sent, because there is
# no queue locally. Not a queue: it dies with the server and never retries.
RUN_WORKER_LOCALLY=true
